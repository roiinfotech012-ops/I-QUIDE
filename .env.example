# Server & Reverse Proxy Port Configuration (Strictly managed via .env)
PORT=3000
HOSTNAME="0.0.0.0"

# Allowed Hosts & Origins for Reverse Proxy / Custom Domains
# Use "*" to allow any reverse-proxy domain, or comma-separated hosts (e.g. "iguide.edu.in,www.iguide.edu.in,localhost:3000")
ALLOWED_HOSTS="*"
AUTH_TRUST_HOST="true"

# PostgreSQL Database Connection (Required for live PostgreSQL persistence via Prisma)
# Example: postgresql://postgres:password@localhost:5432/iguide_cms?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/iguide_cms?schema=public"

# Auth.js / NextAuth Configuration
AUTH_SECRET="iguide-production-grade-secret-replace-in-production-env-98a7f6d5c4b3"
NEXTAUTH_URL="http://localhost:3000"

# Initial Administrator Credentials (Used by seed script and Auth.js provider)
ADMIN_EMAIL="admin@advaita1.com"
ADMIN_PASSWORD="iGuide@Admin2026!"

# Transactional Email Notifications (Resend)
# Leave empty in local development to log structured email payloads without failing enquiry saves.
RESEND_API_KEY=""
ENQUIRY_NOTIFICATION_EMAIL="admin@advaita1.com"
ENQUIRY_FROM_EMAIL="iGUIDE Enquiries <notifications@advaita1.com>"

# Public Site URL for canonical links, OpenGraph, and Sitemap
NEXT_PUBLIC_SITE_URL="https://iguide.edu.in"
